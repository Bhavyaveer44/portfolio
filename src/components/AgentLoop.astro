---
import { loopSteps } from '../data/loop';

interface Props { defaultIndex?: number; periodSeconds?: number }
const { defaultIndex = 0, periodSeconds = 9 } = Astro.props;

const CX = 180, CY = 170, R = 115, W = 88, H = 34;
const pad = (n: number) => String(n + 1).padStart(2, '0');
const nodes = loopSteps.map((step, i) => {
  const a = -Math.PI / 2 + (i * 2 * Math.PI) / loopSteps.length;
  return { step, i, x: Math.round(CX + R * Math.cos(a)), y: Math.round(CY + R * Math.sin(a)) };
});
---
<div data-loop data-default={defaultIndex} data-period={periodSeconds} class="border border-ink bg-cream p-5 md:p-6">
  <svg viewBox="0 0 360 340" role="group" aria-label="Agent loop: perceive, plan, act, observe" class="mx-auto block w-full max-w-[380px] select-none">
    <circle class="ring" cx={CX} cy={CY} r={R} />
    <text class="center" x={CX} y={CY - 4} text-anchor="middle">AGENT</text>
    <text class="center" x={CX} y={CY + 12} text-anchor="middle">LOOP</text>
    {nodes.map(({ step, i, x, y }) => (
      <g
        class:list={['node', { active: i === defaultIndex }]}
        data-node={i}
        data-x={x}
        data-y={y}
        role="button"
        tabindex="0"
        aria-pressed={i === defaultIndex ? 'true' : 'false'}
        aria-label={`${step.name}, step ${i + 1} of ${loopSteps.length}`}
      >
        <rect x={x - W / 2} y={y - H / 2} width={W} height={H} />
        <text x={x} y={y + 5} text-anchor="middle">{step.name}</text>
      </g>
    ))}
    <circle class="dot" r="6" cx={nodes[0].x} cy={nodes[0].y} />
  </svg>

  <div class="mt-5 border-t border-ink pt-4" aria-live="polite">
    {loopSteps.map((step, i) => (
      <section data-step={i}>
        <p class="font-display text-sm font-bold text-vermilion">{pad(i)}</p>
        <h3 class="mt-1 text-2xl font-bold">{step.name}</h3>
        <p class="mt-2 max-w-prose text-sm leading-relaxed text-ink/75">{step.caption}</p>
      </section>
    ))}
  </div>
</div>

<style>
  .ring { fill: none; stroke: var(--color-ink); stroke-width: 1; opacity: 0.35; }
  .center { font: 500 11px var(--font-sans); letter-spacing: 0.2em; fill: var(--color-ink); opacity: 0.5; }
  .node { cursor: pointer; outline: none; }
  .node rect { fill: var(--color-cream); stroke: var(--color-ink); stroke-width: 1; transition: fill 0.2s, stroke 0.2s; }
  .node text { font: 700 14px var(--font-display); fill: var(--color-ink); transition: fill 0.2s; }
  .node.near rect { stroke: var(--color-vermilion); }
  .node.active rect { fill: color-mix(in srgb, var(--color-vermilion) 14%, var(--color-cream)); stroke: var(--color-vermilion); stroke-width: 2; }
  .node.active text { fill: var(--color-vermilion); }
  .node:hover rect { stroke: var(--color-vermilion); }
  .node:focus-visible rect { stroke: var(--color-vermilion); stroke-width: 2.5; stroke-dasharray: 5 3; }
  .dot { fill: var(--color-vermilion); }
</style>

<script>
  const CX = 180, CY = 170, R = 115;
  const TAU = Math.PI * 2;

  document.querySelectorAll<HTMLElement>('[data-loop]').forEach((root) => {
    const nodes = [...root.querySelectorAll<SVGGElement>('[data-node]')]
      .sort((a, b) => Number(a.dataset.node) - Number(b.dataset.node));
    const steps = [...root.querySelectorAll<HTMLElement>('[data-step]')]
      .sort((a, b) => Number(a.dataset.step) - Number(b.dataset.step));
    const dot = root.querySelector<SVGCircleElement>('.dot')!;
    const period = Number(root.dataset.period ?? 9) * 1000;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let current = Number(root.dataset.default ?? 0);

    const place = (a: number) => {
      dot.setAttribute('cx', String(CX + R * Math.cos(a)));
      dot.setAttribute('cy', String(CY + R * Math.sin(a)));
    };
    const nodeAngle = (i: number) => -Math.PI / 2 + (i * TAU) / nodes.length;

    const select = (i: number) => {
      current = i;
      nodes.forEach((n, k) => {
        n.classList.toggle('active', k === i);
        n.setAttribute('aria-pressed', String(k === i));
      });
      steps.forEach((s, k) => { s.hidden = k !== i; });
      if (reduce) place(nodeAngle(i));
    };

    nodes.forEach((n, i) => {
      n.addEventListener('click', () => select(i));
      n.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); select(i); }
        const dir = e.key === 'ArrowRight' || e.key === 'ArrowDown' ? 1 : e.key === 'ArrowLeft' || e.key === 'ArrowUp' ? -1 : 0;
        if (dir) {
          e.preventDefault();
          const next = (i + dir + nodes.length) % nodes.length;
          select(next);
          nodes[next].focus();
        }
      });
    });

    select(current);
    if (reduce) return;

    let raf = 0;
    let visible = true;
    const t0 = performance.now();
    const frame = (now: number) => {
      const a = -Math.PI / 2 + (((now - t0) % period) / period) * TAU;
      place(a);
      const phase = (((a + Math.PI / 2) % TAU) + TAU) % TAU;
      nodes.forEach((n, k) => {
        const d = Math.abs(phase - (k * TAU) / nodes.length);
        n.classList.toggle('near', Math.min(d, TAU - d) < 0.3);
      });
      if (visible) raf = requestAnimationFrame(frame);
    };
    raf = requestAnimationFrame(frame);

    new IntersectionObserver(([entry]) => {
      const was = visible;
      visible = entry.isIntersecting;
      if (visible && !was) raf = requestAnimationFrame(frame);
    }).observe(root);
  });
</script>
