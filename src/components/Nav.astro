---
const links = [
  { href: '/projects', label: 'Work' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];
const path = Astro.url.pathname;
---
<nav class="flex items-center justify-between border-b border-ink px-6 py-4 text-base md:px-10 md:text-lg">
  <a href="/" class="font-display text-lg font-bold tracking-wide text-vermilion md:text-xl">BHAVYAVEER</a>
  <div class="flex items-center gap-4 md:gap-5">
    <div class="flex gap-4 md:gap-5">
      {links.map((l) => (
        <a
          href={l.href}
          class:list={[
            'transition-colors hover:text-vermilion',
            path === l.href && 'text-vermilion',
          ]}
        >{l.label}</a>
      ))}
    </div>
    <button
      type="button"
      data-theme-toggle
      aria-label="Switch to dark mode"
      aria-pressed="false"
      title="Switch to dark mode"
      class="inline-flex size-9 shrink-0 items-center justify-center rounded-full border border-ink transition-colors hover:border-vermilion hover:text-vermilion focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-vermilion"
    >
      <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" class="size-5">
        <path d="M9 18h6M10 22h4" />
        <path d="M15.1 14a6 6 0 1 0-6.2 0c.5.4.9.9 1 1.5h4.2c.1-.6.5-1.1 1-1.5Z" />
        <g data-bulb-rays>
          <path d="M12 0.5v2M4.8 3l1.5 1.5M19.2 3l-1.5 1.5" />
        </g>
      </svg>
    </button>
  </div>
</nav>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');

  if (toggle) {
    const syncToggle = () => {
      const isDark = document.documentElement.dataset.theme === 'dark';
      const label = isDark ? 'Switch to light mode' : 'Switch to dark mode';
      toggle.setAttribute('aria-pressed', String(isDark));
      toggle.setAttribute('aria-label', label);
      toggle.title = label;
    };

    syncToggle();
    toggle.addEventListener('click', () => {
      document.documentElement.dataset.theme =
        document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
      syncToggle();
      localStorage.setItem('theme', document.documentElement.dataset.theme);
    });
  }
</script>

<style>
  :global(html[data-theme='dark'] [data-bulb-rays]) {
    opacity: 0.2;
  }
</style>
