---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ProjectRowHero from '../components/ProjectRowHero.astro';
import { getByPlacement } from '../data/projects';

const heroes = getByPlacement('hero');
---
<BaseLayout title="Bhavyaveer Kumar">
  <!-- HERO -->
  <section class="border-b border-ink px-5 py-8 sm:px-6 md:px-10 md:py-12">
    <div class="mx-auto grid max-w-5xl items-stretch gap-7 md:grid-cols-[minmax(0,1fr)_280px] md:gap-10">
      <div class="flex flex-col items-start justify-center">
        <p class="text-xs uppercase tracking-[0.2em] text-ink/50">About me</p>
        <h1 class="mt-3 text-4xl font-bold md:text-5xl">Hi, I'm Bhavyaveer.</h1>
        <p class="mt-4 max-w-2xl text-base leading-relaxed text-ink/80 md:text-lg">
          I'm an AI engineer who loves exploring how technology can solve real-world problems.
          My learning journey has taken me across quite a few fascinating domains,
          from artificial intelligence and cybersecurity to web development and system design.
          I’ve always believed that real growth happens when you challenge yourself to learn
          something completely new, and that’s the approach I bring to everything I do.
        </p>
      </div>
      <div class="relative mx-auto aspect-square w-full max-w-[280px] md:mx-0 md:aspect-auto md:max-w-none">
        <img src="/images/me.jpg" alt="Bhavyaveer" class="absolute inset-0 h-full w-full object-cover" />
      </div>
    </div>
  </section>

  <!-- SELECTED WORK -->
  <section class="px-5 py-10 sm:px-6 md:px-10 md:py-12">
    <div class="mx-auto max-w-5xl">
      <SectionHeading title="Selected work"/>
      {heroes.map((project, i) => <ProjectRowHero project={project} index={i + 1} />)}
      <div class="border-t border-ink"></div>
    </div>
  </section>

  <!-- MORE WORK BAND -->
  <a href="/projects" class="block bg-ink px-5 py-6 text-cream sm:px-6 md:px-10 md:py-7">
    <div class="mx-auto flex max-w-5xl items-center justify-between gap-4">
      <span class="font-display text-lg font-bold sm:text-xl md:text-2xl">+ 8 more shipped projects</span>
      <span class="text-sm font-bold text-accent">Browse all →</span>
    </div>
  </a>
</BaseLayout>
