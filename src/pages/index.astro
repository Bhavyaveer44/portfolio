---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ProjectRowHero from '../components/ProjectRowHero.astro';
import Button from '../components/Button.astro';
import Figure from '../components/Figure.astro';
import { getByPlacement } from '../data/projects';

const heroes = getByPlacement('hero');
---
<BaseLayout title="Bhavyaveer Kumar">
  <!-- HERO -->
  <section class="border-b border-ink px-6 py-16 md:px-10 md:py-24">
    <div class="mx-auto grid max-w-6xl items-center gap-10 md:grid-cols-[1.2fr_1fr]">
      <div>
        <p class="mb-4 text-xs uppercase tracking-[0.2em] text-ink/50">Engineering systems that think.</p>
        <h1 class="text-5xl font-bold md:text-4xl">
          Architecting <span class="text-vermilion">reliable software</span><br /> and <span class="text-vermilion">intelligent agents</span> from scratch.
        </h1>
        <div class="mt-8 flex flex-wrap gap-3">
          <Button href="/projects">See the work →</Button>
        </div>
      </div>
      <Figure kind="terrain" intensity={0.7} label="Interactive isometric terrain that rises around the pointer" class="mx-auto max-w-md" />
    </div>
  </section>

  <!-- SELECTED WORK -->
  <section class="px-6 py-14 md:px-10">
    <div class="mx-auto max-w-6xl">
      <SectionHeading title="Selected work"/>
      {heroes.map((project, i) => <ProjectRowHero project={project} index={i + 1} />)}
      <div class="border-t border-ink"></div>
    </div>
  </section>

  <!-- MORE WORK BAND -->
  <a href="/projects" class="block bg-ink px-6 py-8 text-cream md:px-10">
    <div class="mx-auto flex max-w-6xl items-center justify-between">
      <span class="font-display text-2xl font-bold">+ 8 more shipped projects</span>
      <span class="text-sm font-bold text-vermilion">Browse all →</span>
    </div>
  </a>
</BaseLayout>
